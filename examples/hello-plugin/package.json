{
  "name": "dsh-hello-plugin",
  "version": "0.1.0",
  "description": "A minimal DeepSeek Harness bundle: a model-callable greeting tool plus a tool-result observer.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./observer": "./observer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "observer.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.11",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
